# ==========================================
# 1. Dependencies & Package Managers (pnpm)
# ==========================================
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.yarn/

# ==========================================
# 2. Build Outputs & Compiler Caches
# ==========================================
# Root & Workspace Build Dirs
dist/
build/
out/
.turbo/
.cache/
.parcel-cache/
.vite/
.next/
.nuxt/

# TypeScript Incremental Caches (generated across apps/packages)
*.tsbuildinfo
tsconfig.tsbuildinfo

# Linter Caches
.eslintcache
.stylelintcache
.oxlintcache

# ==========================================
# 3. Environment Variables & Secrets (CRITICAL)
# ==========================================
# Ignore all .env files across root, apps, and packages
.env
.env.*
*.env.bak
*.pem
*.key

# BUT allow committing example environment files
!.env.example
!apps/*/.env.example
!packages/*/.env.example

# ==========================================
# 4. Backend Logs & Database Backups
# ==========================================
# Ignore backend runtime logs
apps/backend/logs/*
!apps/backend/logs/.gitkeep

# General log and database dump files
*.log
*.sqlite
*.sql.bak
*.sql.dump

# IMPORTANT: Do NOT ignore Drizzle migration SQL files!
# If your migrations are in 'drizzle/', Git will track them by default.

# ==========================================
# 5. Editor & IDE Settings
# ==========================================
# Vim / Neovim
*.swp
*.swo
*~
.netrwhist
.nvim/

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ)
.idea/

# AI Tooling & Assistants
.claude/
.aider*
.cursor/
.windsurf/

# ==========================================
# 6. Operating System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
